# Database URL (SQLite locally, or PostgreSQL/Turso for production)
DATABASE_URL="file:./prisma/readlog.db"

# Google Gemini API Key for Socratic AI Sparring & Weekly Reviews
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional: Google Gemini Model Override (defaults to gemini-2.5-flash-lite)
GEMINI_MODEL="gemini-2.5-flash-lite"

# Optional: Email SMTP settings for scheduled reflection reminders
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="OmniLog AI <notifications@omnilog.ai>"
